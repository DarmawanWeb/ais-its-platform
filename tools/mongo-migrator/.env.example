# ais-its-mongo-migrator — environment variables. The tool reads no file: load a copy into the
# shell (`set -a; . ./.env; set +a`). Placeholders only, and keep secrets out of every file:
# export MIGRATION_ADMIN_PASSWORD and PGPASSWORD in the shell for the migration window, e.g.
#   read -rs MIGRATION_ADMIN_PASSWORD && export MIGRATION_ADMIN_PASSWORD
#   read -rs PGPASSWORD && export PGPASSWORD

# --- Source: the MVP MongoDB (read only; a secondary is preferred) ---------------------
MONGO_URL='mongodb://<user>:<password>@localhost:27017/?authSource=admin'
MONGO_DB=aisits_legacy

# --- Target: v2 APIs (the gateway, or one base URL per service) -------------------------
V2_GATEWAY_URL=http://localhost:8000
# V2_AUTH_URL=http://localhost:3001
# V2_FLEET_URL=http://localhost:3002
# V2_EMISSION_URL=http://localhost:3006

# Platform admin (super_admin, without MFA) used through POST /api/v2/auth/login.
MIGRATION_ADMIN_EMAIL=admin@ais-its.local
# MIGRATION_ADMIN_PASSWORD=   (export it in the shell, see above)

# Organization (uuid) that owns every migrated tenant record (or --org <uuid>).
MIGRATION_TARGET_ORG_ID=

# --- Target: direct SQL for the history entities (role mongo_migrator) -------------------
# Created disabled by infra/postgres/bootstrap.sql; enabled for the migration window with
# -v migrator_password=… (see docs/migration/MONGO_TO_V2.md).
# The password comes from PGPASSWORD (node-postgres default) when the URL has none.
# TLS: node-postgres treats sslmode=require as verify-full. A TLS cluster with its own CA:
#   ?sslmode=verify-full&sslrootcert=/path/to/ca.pem
# (?uselibpqcompat=true&sslmode=require gives libpq's encrypted-but-unverified mode). The compose
# stack has no TLS: no sslmode at all.
DATABASE_URL=postgres://mongo_migrator@localhost:5432/aisits
DATABASE_STATEMENT_TIMEOUT_MS=120000

# --- Registry particulars: the fleet service's own importer ------------------------------
# Runs through /bin/sh in the directory the CLI is started from (tools/mongo-migrator in the
# runbook); {file} becomes the absolute path of the NDJSON export. Empty: export only, and the
# registry entity stays `manual` until a run with the command. Keep the single quotes.
# Platform services on the host (infra/compose runs only the backing services):
# FLEET_REGISTRY_IMPORT_CMD='cd ../../services/fleet && node --env-file=.env dist/registry-import.js {file}'
# Fleet in a container:
# FLEET_REGISTRY_IMPORT_CMD='docker exec -i <fleet-container> node dist/registry-import.js /dev/stdin < {file}'
FLEET_REGISTRY_IMPORT_CMD=

# --- Behaviour ------------------------------------------------------------------------
MIGRATION_STATE_DIR=.migration-state
MIGRATION_BATCH_SIZE=1000
MIGRATION_HTTP_TIMEOUT_MS=30000
MIGRATION_HTTP_RETRIES=5
MIGRATION_HTTP_CONCURRENCY=4
# How long to wait until the emission service has the FLEET snapshot of a new vessel.
MIGRATION_PROJECTION_WAIT_MS=120000
MIGRATION_SAMPLE_SIZE=50

# Retention / plausibility rules of the target services (keep them equal to the services').
MIGRATION_AIS_MAX_AGE_DAYS=180
MIGRATION_FUEL_MAX_AGE_DAYS=1825
MIGRATION_FUEL_MAX_ME_TON=500
MIGRATION_FUEL_MAX_AE_TON=100
MIGRATION_TRANSHIPMENT_MAX_AGE_DAYS=730
MIGRATION_TRANSHIPMENT_CRITICAL_ACCURACY=90
