# =============================================================================
# SEEMP local infrastructure — every variable read by docker-compose.yml
# =============================================================================
#   cp infra/compose/.env.example infra/compose/.env
#
# Compose reads infra/compose/.env automatically (it sits next to the compose
# file). The file is optional: each value below is also the built-in default.
# These are DEVELOPMENT values (spec §4) — never reuse them anywhere else, and
# never commit a real .env (it is git-ignored).
#
# Database role passwords are applied on the FIRST start only (empty volume).
# To change them later, re-run infra/postgres/bootstrap.sql (it also rotates)
# or reset with `docker compose down -v`.
# =============================================================================

# Interface the published ports bind to. Loopback keeps the unauthenticated dev
# services off the network; 0.0.0.0 exposes them (e.g. to test from a phone).
BIND_ADDRESS=127.0.0.1

# --- PostgreSQL 17 + TimescaleDB + PostGIS (spec §6) --------------------------
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres            # superuser "postgres"
AUTH_SVC_PASSWORD=auth_svc            # role auth_svc      → schema auth
FLEET_SVC_PASSWORD=fleet_svc          # role fleet_svc     → schema fleet
AIS_SVC_PASSWORD=ais_svc              # role ais_svc       → schema ais
TELEMETRY_SVC_PASSWORD=telemetry_svc  # role telemetry_svc → schema telemetry
EMISSION_SVC_PASSWORD=emission_svc    # role emission_svc  → schema emission
DETECTION_SVC_PASSWORD=detection_svc  # role detection_svc → schema detection
NOTIFY_SVC_PASSWORD=notify_svc        # role notify_svc    → schema notify
TILES_RO_PASSWORD=tiles_ro            # read-only role used by Martin

# --- NATS JetStream + MQTT (spec §7) ------------------------------------------
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_MQTT_PORT=1883

# --- Valkey -------------------------------------------------------------------
VALKEY_PORT=6379

# --- S3-compatible object storage (RustFS) ------------------------------------
S3_API_PORT=9000
S3_CONSOLE_PORT=9001                  # console: http://localhost:9001/rustfs/console/
S3_ACCESS_KEY=seemp-dev               # root credentials; services use the same pair in dev
S3_SECRET_KEY=seemp-dev-secret
S3_REGION=us-east-1
S3_BUCKETS=vessel-photos              # space-separated, created on every start

# --- Mailpit ------------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Gateway (Traefik) --------------------------------------------------------
GATEWAY_PORT=8000
GATEWAY_DASHBOARD_PORT=8090

# --- Observability (Grafana LGTM) ---------------------------------------------
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
GRAFANA_ADMIN_PASSWORD=admin          # anonymous access is also enabled (Admin role) in dev

# --- Martin vector tiles (profile "tiles") -------------------------------------
MARTIN_PORT=3010
# The Docker Hub image is the last one published there (v0.8). Current releases
# are on GHCR, e.g. MARTIN_IMAGE=ghcr.io/maplibre/martin:<version>.
MARTIN_IMAGE=maplibre/martin:latest

# --- MVP API /api/v1 (profile "legacy"): MongoDB 7 + legacy/be ----------------
MONGO_PORT=27017
MONGO_ROOT_USERNAME=seemp
MONGO_ROOT_PASSWORD=seemp-dev
MONGO_DB_NAME=seemp_legacy
LEGACY_BE_PORT=3020
LEGACY_JWT_SECRET=dev-legacy-jwt-secret-change-me
LEGACY_REFRESH_TOKEN_SECRET=dev-legacy-refresh-secret-change-me
# Upstream AIS socket.io feeds of the MVP (empty = not connected).
LEGACY_AIS_PRIMARY_URL=
LEGACY_AIS_BATAM_URL=
LEGACY_AIS_TOKEN=
