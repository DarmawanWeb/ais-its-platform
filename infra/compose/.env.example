# =============================================================================
# AIS Maritime Intelligence local infrastructure — every variable read by
# docker-compose.yml
# =============================================================================
#   cp infra/compose/.env.example infra/compose/.env
#
# Compose reads infra/compose/.env automatically (it sits next to the compose
# file). The file is optional: each value below is also the built-in default.
# These are DEVELOPMENT values (spec §4) — never reuse them anywhere else, and
# never commit a real .env (it is git-ignored).
#
# Database role passwords are applied every time compose starts Postgres
# (infra/postgres/bootstrap.sh): change one here, then `docker compose up -d`.
# =============================================================================

# --- Published ports: which interface they bind to ---------------------------
# Gateway :8000 only. Set 0.0.0.0 to open the app from another device (phone,
# LAN); everything behind the gateway still requires a login. Add that origin
# to LEGACY_ALLOWED_ORIGINS below and to the services' CORS_ORIGINS.
GATEWAY_BIND_ADDRESS=127.0.0.1
# S3 API :9000 only — needed by other devices to load presigned photo URLs
# (then also set S3_PUBLIC_ENDPOINT=http://<this-host-ip>:9000 for fleet).
# WARNING: with 0.0.0.0 anyone on the network can use the root keys below.
S3_BIND_ADDRESS=127.0.0.1
# Every other port. KEEP 127.0.0.1: these services have no authentication or
# public dev credentials — Postgres superuser, NATS/MQTT, Valkey, Traefik API,
# Grafana, Mailpit (password-reset e-mails), S3 console, Martin, MongoDB.
BIND_ADDRESS=127.0.0.1

# --- PostgreSQL 17 + TimescaleDB + PostGIS (spec §6), database "aisits" -------
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres                  # superuser "postgres"
AUTH_SVC_PASSWORD=auth_svc                  # role auth_svc         → schema auth
FLEET_SVC_PASSWORD=fleet_svc                # role fleet_svc        → schema fleet
AIS_SVC_PASSWORD=ais_svc                    # role ais_svc          → schema ais
TELEMETRY_SVC_PASSWORD=telemetry_svc        # role telemetry_svc    → schema telemetry
EMISSION_SVC_PASSWORD=emission_svc          # role emission_svc     → schema emission
GEO_SVC_PASSWORD=geo_svc                    # role geo_svc          → schema geo
SAFETY_SVC_PASSWORD=safety_svc              # role safety_svc       → schema safety
SURVEILLANCE_SVC_PASSWORD=surveillance_svc  # role surveillance_svc → schema surveillance
NOTIFY_SVC_PASSWORD=notify_svc              # role notify_svc       → schema notify
TILES_RO_PASSWORD=tiles_ro                  # read-only role used by Martin

# --- NATS JetStream + MQTT (spec §7) ------------------------------------------
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_MQTT_PORT=1883

# --- Valkey -------------------------------------------------------------------
VALKEY_PORT=6379

# --- S3-compatible object storage (RustFS) ------------------------------------
S3_API_PORT=9000
S3_CONSOLE_PORT=9001                  # console: http://localhost:9001/rustfs/console/
S3_ACCESS_KEY=aisits-dev              # root credentials; services use the same pair in dev
S3_SECRET_KEY=aisits-dev-secret
S3_REGION=us-east-1
S3_BUCKETS=vessel-photos              # comma-separated, created on every start

# --- Mailpit ------------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Gateway (Traefik) --------------------------------------------------------
GATEWAY_PORT=8000
GATEWAY_DASHBOARD_PORT=8090
# Where the routes of traefik/dynamic/routes.yml send requests: "host" = the
# `pnpm dev` processes on this machine; "stack" = containers on the "aisits"
# network named after their spec §3 hostname (auth, fleet, …, web:8080).
GATEWAY_UPSTREAMS=host

# --- Observability (Grafana LGTM) ---------------------------------------------
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
GRAFANA_ADMIN_PASSWORD=admin          # anonymous visitors are Viewers; log in to edit

# --- Martin vector tiles (profile "tiles") -------------------------------------
MARTIN_PORT=3010
# Docker Hub only has Martin up to v0.8.0; current releases are on GHCR, e.g.
#   MARTIN_IMAGE=ghcr.io/maplibre/martin:1.16.1
#   MARTIN_EXTRA_ARGS=--base-path /tiles      # TileJSON URLs behind the gateway
# (v0.8.0 has no --base-path: use the tile URL template /tiles/<source>/{z}/{x}/{y}).
MARTIN_IMAGE=maplibre/martin:v0.8.0
MARTIN_EXTRA_ARGS=

# --- MVP API /api/v1 (profile "legacy"): MongoDB 7 + legacy/be ----------------
MONGO_PORT=27017
MONGO_ROOT_USERNAME=aisits
MONGO_ROOT_PASSWORD=aisits-dev
MONGO_DB_NAME=aisits_legacy
# ≥ 32 characters: the MVP API runs with NODE_ENV=production and refuses shorter ones.
LEGACY_JWT_SECRET=dev-only-legacy-jwt-secret-change-me
LEGACY_REFRESH_TOKEN_SECRET=dev-only-legacy-refresh-secret-change-me
# Browser origins that may write to /api/v1 through the gateway (others get 403).
LEGACY_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
# Upstream AIS socket.io feeds of the MVP. Empty = no live feed: the MVP API
# then dials its built-in default (http://localhost:8080) and logs a
# connection error every few seconds; it still serves the data in MongoDB.
LEGACY_AIS_PRIMARY_URL=
LEGACY_AIS_BATAM_URL=
LEGACY_AIS_TOKEN=
